{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pack",
  "description": "A texture pack we host (or hold back). One file per pack at data/packs/<key>.yaml. Human-owned descriptive facts only: hashes, sizes and object names live in data/archives/ and are written by the conversion pipeline.",
  "type": "object",
  "required": ["key", "name", "game", "credits", "hosting"],
  "additionalProperties": false,
  "properties": {
    "key": {
      "description": "Immutable repo handle, equal to the file name: <lowest serial>-<lead creator id>[-n]. Short on purpose, so paths stay valid on Windows.",
      "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"
    },
    "catalog_id": {
      "description": "The id the app sees, when it predates this repo (the 517 inherited ids; up to 228 characters, never changed). Absent for new packs, whose id is `key`.",
      "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,254}$"
    },
    "name": {"type": "string", "minLength": 1, "maxLength": 200},
    "game": {
      "type": "object", "additionalProperties": false, "required": ["title", "serials"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "serials": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z]{4}-\\d{5}$"}}
      }
    },
    "credits": {
      "description": "Who made it, lead first. Empty means no one has named the creator, which is different from a missing field.",
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["creator"],
        "properties": {
          "creator": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,47}$"},
          "role": {"enum": ["author", "converter", "contributor", "port"], "default": "author"},
          "note": {"type": "string"}
        }
      }
    },
    "type": {"enum": ["ai_upscale", "handcrafted", "mixed", "port", "button_replacement", "unknown"]},
    "completeness": {"enum": ["complete", "in_progress", "incomplete", "partial", "unknown"]},
    "description": {"type": "string", "maxLength": 2000},
    "version": {"description": "The pack's version as its creator labels it. Shown with the pack in the app's catalog.", "type": "string", "maxLength": 200},
    "sources": {
      "description": "Pages about the pack: where it is announced or distributed. Never the address of our own copy.",
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["kind", "url"],
        "properties": {
          "kind": {"enum": ["forum_thread", "creator_page", "repository", "mirror", "video", "shop", "other"]},
          "url": {"$ref": "#/$defs/url"},
          "primary": {"type": "boolean"},
          "note": {"type": "string"}
        }
      }
    },
    "access": {
      "description": "Override for what the pack costs the public at the creator's own distribution point. Normally derived from the matched sheet listing (data/links/listing-pack.jsonl); set this only to correct it, with evidence.",
      "type": "object", "additionalProperties": false, "required": ["cost"],
      "properties": {
        "cost": {"enum": ["free", "free_with_ads", "paid", "unknown"]},
        "evidence": {"$ref": "#/$defs/url"},
        "note": {"type": "string"}
      }
    },
    "permission": {
      "description": "Our right to host a copy. Separate from cost: free to download is not permission to redistribute.",
      "type": "object", "additionalProperties": false, "required": ["kind"],
      "properties": {
        "kind": {"enum": ["creator_uploaded", "creator_approved", "community_mirror", "unknown", "revoked"]},
        "evidence": {"$ref": "#/$defs/url"},
        "date": {"$ref": "#/$defs/date"},
        "note": {"type": "string"}
      }
    },
    "hosting": {
      "type": "object", "additionalProperties": false, "required": ["state"],
      "properties": {
        "state": {"enum": ["draft", "review", "published", "withheld", "withdrawn", "disputed"]},
        "reason": {"type": "string"},
        "since": {"$ref": "#/$defs/date"}
      }
    },
    "media": {
      "description": "Example pictures and videos for the pack's page. Pictures are the creator's own screenshots and are credited to them. Image files are never in git: `source_url` is where the creator shows it, `storage_key` names our resized copy once made. A video is a YouTube id; the site shows a thumbnail and loads the player only on a click.",
      "type": "object", "additionalProperties": false,
      "properties": {
        "images": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "anyOf": [{"required": ["source_url"]}, {"required": ["storage_key"]}],
            "properties": {
              "source_url": {"$ref": "#/$defs/url"},
              "thumb_url": {"$ref": "#/$defs/url"},
              "storage_key": {"type": "string", "minLength": 1},
              "alt": {"type": "string", "maxLength": 200},
              "caption": {"type": "string", "maxLength": 200},
              "credit": {"description": "Creator id of whoever made the picture.", "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,47}$"}
            }
          }
        },
        "videos": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["provider", "id"],
            "properties": {
              "provider": {"enum": ["youtube"]},
              "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{11}$"},
              "title": {"type": "string", "maxLength": 200},
              "uploader": {"description": "Channel name as published.", "type": "string", "maxLength": 100}
            }
          }
        }
      }
    },
    "needs_review": {
      "description": "Credits nobody has checked yet; a person removes an entry once checked. Facts that can be computed (no matching listing, paid but hosted) are reported by `ps2ktxpak report`, never stored here.",
      "type": "array", "uniqueItems": true,
      "items": {"enum": ["credit_assigned_from_listing", "co_credit_unconfirmed", "credit_unknown"]}
    }
  },
  "$defs": {
    "url": {"type": "string", "pattern": "^https://[^\\s]+$", "maxLength": 2048},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
  }
}
